# 钉钉企业内部应用凭证（在 https://open-dev.dingtalk.com 获取）
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret

# 操作人身份：二选一即可（该用户需对目标多维表有查看/编辑权限）
# 方式 A（推荐）：直接填 unionId
DINGTALK_OPERATOR_ID=your_union_id
# 方式 B：填手机号，脚本自动换取 unionId（需额外开通通讯录“根据手机号获取成员”权限）
# DINGTALK_MOBILE=13800138000

# 你的钉钉 AI 表格坐标（已按你提供的链接预填）
DINGTALK_BASE_ID=MNDoBb60VLrYNqLqInx6PzPA8lemrZQ3
DINGTALK_SHEET_ID=AEFsFrm
DINGTALK_SOURCE_URL=https://alidocs.dingtalk.com/i/nodes/MNDoBb60VLrYNqLqInx6PzPA8lemrZQ3?utm_scene=person_space&iframeQuery=viewId%3Dc9vuiLa%26sheetId%3DAEFsFrm
